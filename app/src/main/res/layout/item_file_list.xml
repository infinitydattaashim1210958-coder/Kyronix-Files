<?xml version="1.0" encoding="utf-8"?>
<!--
    List item: matches Samsung My Files list row.
    Heights use dp, text in sp — survives font-scale changes on MIUI.
    No CardView (avoids double elevation on some MIUI builds).
    Uses ?selectableItemBackground for ripple — works on all API levels.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/item_selected_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

    <!-- Selection checkbox (visible only in selection mode) -->
    <ImageView
        android:id="@+id/iv_checkbox"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_checkbox_unchecked"
        android:visibility="gone"
        android:contentDescription="@null"
        tools:visibility="visible" />

    <!-- File / folder icon -->
    <ImageView
        android:id="@+id/iv_file_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_file_folder"
        android:contentDescription="@null" />

    <!-- Name + meta column (takes all remaining width) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="SomeReallyLongFileName_document.pdf" />

        <TextView
            android:id="@+id/tv_file_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="4.2 MB  ·  9 Oct 2026, 14:30" />

    </LinearLayout>

    <!-- Three-dot overflow -->
    <ImageButton
        android:id="@+id/btn_overflow"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_more_vert"
        android:contentDescription="@string/desc_file_options"
        android:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
