<?xml version="1.0" encoding="utf-8"?>
<!--
    Kyronix Files colour palette
    Brand: deep slate-blue primary, electric-cyan accent — deliberately not
    the AI-default terracotta/cream or near-black + acid-green.
    All named with their semantic role so values-night can simply override.
-->
<resources>
    <!-- Brand primaries -->
    <color name="brand_primary">#1A237E</color>    <!-- deep indigo -->
    <color name="brand_primary_dark">#0D1757</color>
    <color name="brand_primary_light">#3949AB</color>
    <color name="accent_primary">#00BCD4</color>   <!-- cyan accent -->
    <color name="accent_dark">#0097A7</color>

    <!-- Surface / background -->
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#F0F2FF</color>  <!-- very faint indigo tint -->
    <color name="background">#F5F6FA</color>

    <!-- On-surface text -->
    <color name="on_surface">#1C1B2E</color>
    <color name="on_surface_variant">#5C5C7A</color>
    <color name="on_surface_disabled">#ABABC4</color>

    <!-- Icon colours per file type -->
    <color name="icon_folder">#F9A825</color>      <!-- amber -->
    <color name="icon_image">#4CAF50</color>        <!-- green -->
    <color name="icon_video">#E91E63</color>        <!-- pink -->
    <color name="icon_audio">#9C27B0</color>        <!-- purple -->
    <color name="icon_document">#1976D2</color>     <!-- blue -->
    <color name="icon_apk">#43A047</color>          <!-- green-dark -->
    <color name="icon_archive">#FF7043</color>      <!-- deep-orange -->
    <color name="icon_text">#607D8B</color>         <!-- blue-grey -->
    <color name="icon_unknown">#9E9E9E</color>      <!-- grey -->

    <!-- Selection highlight -->
    <color name="selection_bg">#1A1A237E</color>   <!-- 10% indigo -->
    <color name="chip_bg">#E8EAF6</color>           <!-- indigo 50 -->

    <!-- Status bar / nav bar -->
    <color name="status_bar">#0D1757</color>

    <!-- Material3 seed (used by themes.xml dynamic-color fallback) -->
    <color name="md_theme_seed">#1A237E</color>
</resources>
